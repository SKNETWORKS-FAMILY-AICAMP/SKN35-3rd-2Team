# 사용법: 이 파일을 ".env"로 복사한 뒤 값을 채운다. (.env는 .gitignore에 있어서 저장소에 올라가지 않는다)
# 이 파일(.env.example)에는 절대 실제 비밀번호나 키를 적지 않는다. 키 이름과 설명만 둔다.

# ------------------------------------------------------------
# DB 접속 (TiDB Cloud) - src/db/engine.py
# ------------------------------------------------------------
# TiDB Cloud 콘솔 > 인스턴스 > Connect 화면에서 확인한다.
# 주의: 다른 프로젝트(1차/2차)의 DB 값을 그대로 쓰지 않는다. 3차 프로젝트 전용 인스턴스/데이터베이스를 쓴다.
DB_HOST=
DB_PORT=4000
# 사용자 이름에는 인스턴스별 접두사가 붙어 있다 (콘솔에 나온 그대로 넣는다)
DB_USERNAME=
DB_PASSWORD=
# 시스템용 DB(sys, mysql, test 등)가 아니라 우리 전용 데이터베이스 이름
DB_DATABASE=
# (선택) 인증서 파일 경로. 비워 두면 certifi 기본 인증서를 쓴다.
DB_SSL_CA=
# (선택) TLS(암호화 연결) 사용 여부: true / false. 비워 두면 자동으로 정한다.
#   - 로컬 주소(localhost, 127.0.0.1)면 끄고, 그 밖의 서버(TiDB Cloud 등)면 켠다.
DB_SSL=

# --- 개발(로컬 MySQL)과 배포(TiDB)를 나눠 쓰는 방법 ---
# 개발: .env 에 로컬 MySQL 접속 정보를 둔다. 예)
#   DB_HOST=localhost / DB_PORT=3306 / DB_USERNAME=skn35_3rd / DB_DATABASE=skn35_3rd
# 배포(TiDB): TiDB 접속 정보는 별도 파일(예: .env.tidb, .gitignore의 .env.* 규칙으로 제외됨)에 두고,
#   명령 앞에 ENV_FILE을 붙여 그 파일을 읽게 한다. 예)
#   ENV_FILE=.env.tidb alembic -c src/db/alembic.ini upgrade head
#   ENV_FILE=.env.tidb python -m src.db.seed
# 로컬 MySQL은 3차 프로젝트 전용 사용자와 데이터베이스를 따로 만들어 쓴다 (다른 프로젝트 DB와 섞이지 않게).

# (선택) 접속 문자열 전체를 직접 지정하면 위 DB_* 보다 우선한다. 예: sqlite:///./local.sqlite3
# DATABASE_URL=

# (선택) 다른 환경 파일을 읽고 싶을 때, 실행 명령 앞에 ENV_FILE=파일이름 을 붙인다 (환경변수이므로 이 파일에는 적지 않는다).
#   이렇게 지정한 파일은 이미 읽힌 값(예: .env의 로컬 DB 값)보다 우선한다.
#   지정하지 않으면 .env를 읽되, 이미 설정된 환경변수는 덮어쓰지 않는다.

# ------------------------------------------------------------
# 대화 이력 반영 상한 - src/db/history.py
# ------------------------------------------------------------
# 비워 두면 기본값(6턴, 1500토큰)을 쓴다. 평가하면서 조정한다.
# HISTORY_MAX_TURNS=6
# HISTORY_MAX_TOKENS=1500

# ------------------------------------------------------------
# 저장 크기 상한 - src/db/limits.py, src/db/images.py
# ------------------------------------------------------------
# DB 설정의 기본값은 src/const/db_config.py 한곳에 있다 (여기 적힌 값은 그 파일의 기본값과 같다). 바꾸고 싶을 때만 아래를 쓴다.
# 비워 두면 아래 기본값을 쓴다. 기본값은 TiDB Cloud Starter의 "한 행 최대 6MiB" 제한(실제 시험으로 확인,
# 넘으면 오류 8025 entry too large)을 넘지 않도록 잡은 값이다. 값을 키울 때는 이 제한을 먼저 확인한다.
# 이미지 한 장의 최대 크기(바이트). 기본 2000000 (약 2MB). 이미지를 올리는 쪽에서 shrink_image로 이 크기 이하로 줄여서 보낸다.
# IMAGE_MAX_BYTES=2000000
# 한 메시지에 붙일 수 있는 이미지 수. 기본 3
# IMAGE_MAX_PER_MESSAGE=3
# 질문 한 건의 최대 글자 수. 기본 200000. 넘으면 질문은 거부하고, 답변은 잘라서 저장한다.
# MESSAGE_MAX_CHARS=200000
# 출처 발췌문, 대화 요약의 최대 글자 수. 기본 50000. 넘으면 잘라서 저장한다.
# SNIPPET_MAX_CHARS=50000
# SUMMARY_MAX_CHARS=50000

# ------------------------------------------------------------
# 초기 계정(시드 계정) 만들기 - python -m src.db.seed
# ------------------------------------------------------------
# 시드 계정이란: DB에 처음 한 번 스크립트로 미리 만들어 두는 계정이다.
#
# [관리자 계정 (SEED_ADMIN_*)]
# - 왜 필요한가: 이메일을 받지 않아서 "비밀번호 찾기"가 없다. 비밀번호를 잊은 사용자의 비밀번호 초기화,
#   계정 비활성화/재활성화, 사용자 목록 조회는 관리자만 할 수 있다.
# - 가입 화면으로는 관리자 계정을 만들 수 없다 (가입은 항상 일반 계정). 관리자는 이 시드로만 만든다.
# - 아직 정하지 않았다면 비워 둔다. 비워 두면 관리자 계정은 만들어지지 않는다.
#
# [일반 계정 (SEED_USER_*)] (선택)
# - 가입 화면이 생기면 없어도 된다. 가입 화면 없이 로그인을 시연해야 할 때만 쓴다.
#
# 규칙
# - 값이 비어 있으면 그 계정은 만들지 않고, 이미 있는 계정도 건너뛴다 (여러 번 실행해도 안전).
# - 아이디: 영문 소문자, 숫자, 밑줄(_) 3~30자. 비밀번호: 8자 이상.
# - 비밀번호는 이 파일(.env.example)이 아니라 각자의 .env에만 적는다. 채팅 등에 붙여 넣지 않는다.
#
# 공유 DB 규칙 (팀이 같은 TiDB 인스턴스를 같이 쓰는 경우)
# - 시드와 DB 구조 변경(alembic upgrade head)은 팀에서 정한 담당자 한 명만 실행한다.
#   (여러 명이 실행해도 시드는 중복으로 만들어지지 않지만, 구조 변경은 순서가 어긋나면 오류가 난다.)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_USER_USERNAME=
SEED_USER_PASSWORD=

# ------------------------------------------------------------
# LLM / 임베딩 / 리랭커 / 벡터 DB 설정 - dev의 src/const/config.py가 읽는 이름 (2026-10-09 기준)
# ------------------------------------------------------------
# 팀이 OpenAI + Pinecone으로 통일했다. 이름과 기본값은 src/const/config.py를 그대로 옮긴 것이고,
# 이름이 바뀌면 그 파일 담당자가 이 목록도 같이 고친다. 값은 각자 발급받아 자기 .env에만 넣고, 채팅이나 저장소에 올리지 않는다.
#
# 주의: 아래 선택 항목은 일부러 맨 앞에 #을 붙여 두었다. 바꾸고 싶은 것만 # 을 지우고 값을 적는다.
#   이유: config.py가 os.getenv("이름", 기본값)으로 읽는데, 환경변수가 "비어 있으면" 기본값이 아니라 빈 문자열을 그대로 쓴다.
#   그래서 "CHUNK_SIZE=" 처럼 빈 줄로 두면 int("")에서 오류가 나고, 모델명이나 인덱스 이름이 빈 값이 된다.
#   키(OPENAI_API_KEY, PINECONE_API_KEY)만 반드시 채운다.
#
# 팀이 정한 모델 (코드 기본값과 같으므로 모델 항목은 적지 않아도 된다):
#   채팅      gpt-4o-mini            (이미지 입력, 구조화 출력, 함수 호출 지원 - OpenAI 공식 모델 페이지로 확인)
#   임베딩    text-embedding-3-small (1536차원. Pinecone 인덱스도 1536차원으로 만들어야 한다)
#   리랭커    BAAI/bge-reranker-v2-m3 (로컬 모델. sentence-transformers 패키지가 필요하고 첫 실행 때 큰 파일을 내려받는다)

# --- OpenAI -------------------------------------------------
# API 키. config.py가 OPEN_API_KEY를 먼저 읽고, 없으면 OPENAI_API_KEY를 읽는다. 둘 중 하나로 넣으면 된다.
OPENAI_API_KEY=
# 채팅 모델 이름 (기본: gpt-4o-mini). 다른 모델을 시험할 때만 바꾼다.
# OPEN_MODEL=
# 임베딩 모델 (기본: text-embedding-3-small = 1536차원)
# OPEN_EMBEDDING=
# 임베딩 차원 (기본: 1536). Pinecone 인덱스 차원과 반드시 같아야 한다. 임베딩 모델을 바꾸면 인덱스도 다시 만든다.
# EMBEDDING_DIM=
# 리랭커(재정렬) 모델 (기본: BAAI/bge-reranker-v2-m3, 로컬에서 돌고 첫 실행 때 큰 파일을 내려받는다)
# RERANK_MODEL=

# --- Pinecone -----------------------------------------------
PINECONE_API_KEY=
# 인덱스 이름 (기본: skn35-rag). 팀 모두가 같은 이름을 쓰고, 인덱스를 만드는 일은 한 사람만 한다.
# PINECONE_INDEX_NAME=
# 무료(Starter) 플랜 지역 (기본: aws / us-east-1, config.py 주석 기준이며 공식 문서로 확인하지는 않았다)
# PINECONE_CLOUD=
# PINECONE_REGION=

# --- 문서 청크 ----------------------------------------------
# 글자 수 기준 (기본: 1000 / 150)
# CHUNK_SIZE=
# CHUNK_OVERLAP=
